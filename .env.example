# LivingADR environment template (.env.example)
#
# Copy this file to `.env` and replace every placeholder with a real value.
# This file contains PLACEHOLDERS ONLY — never commit real secrets.
#
# Secrets (webhook secret, API keys, UI token) belong in the environment or a
# vault, never in living-adr.config.yaml. Configuration is read at startup:
# after changing config or these variables you must RESTART both deployables
# (`living-adr-workflow` and `living-adr-mcp`). There is no hot reload.

# Path to the typed repository configuration (feature 002 loader).
LIVING_ADR_CONFIG=/etc/living-adr/living-adr.config.yaml

# GitHub App identity + credentials (feature 003 provider seam).
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem

# HMAC secret used to verify inbound GitHub webhook signatures.
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret

# Anthropic API key for ADR drafting (consumed by later features).
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# LangSmith API key for observability export (feature 013).
LANGSMITH_API_KEY=replace-with-langsmith-api-key

# Bearer token guarding the local review UI.
LIVING_ADR_UI_TOKEN=replace-with-ui-token

# Directory for local graph/ingestion persistence.
LIVING_ADR_STORAGE_PATH=/var/lib/living-adr
